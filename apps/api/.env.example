# Names only. Real values come from your secret store (Render/Vercel env, KMS) and never enter git.
ENV=dev
DATABASE_URL=postgresql+asyncpg://releaseradar_app:<password>@localhost:5432/releaseradar
MIGRATION_DATABASE_URL=postgresql+asyncpg://releaseradar_owner:<password>@localhost:5432/releaseradar
REDIS_URL=redis://:<password>@localhost:6379/0
WEB_ORIGIN=http://localhost:3000
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=          # >= 32 random chars: openssl rand -hex 32
ENCRYPTION_KEYS=                # key1:<python -m app.core.crypto>
ENCRYPTION_CURRENT_KEY_ID=key1
